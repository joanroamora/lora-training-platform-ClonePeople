NODE_ENV=development
PORT=8080
LOG_LEVEL=info
SERVICE_NAME=lora-training-api
APP_VERSION=0.2.0
REQUEST_BODY_LIMIT=1mb
TRAINING_API_ENABLED=false
GCP_PROJECT_ID=replace-with-project-id
GCP_REGION=us-central1
GCS_DATA_BUCKET=replace-with-data-bucket
VERTEX_TRAINER_IMAGE_URI=us-central1-docker.pkg.dev/replace-with-project-id/lora-training-dev-containers/trainer:latest
VERTEX_TRAINER_SERVICE_ACCOUNT=replace-with-trainer-service-account
TRAINER_MODE=smoke
TRAINING_PLATFORM=vertex
CLOUD_RUN_TRAINER_JOB=
LORA_BASE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
SIGNED_URL_TTL_SECONDS=900
MAX_IMAGE_BYTES=15728640
MAX_TRAINING_STEPS=800
LEARNING_RATE=0.0001
TRAINING_SEED=42
